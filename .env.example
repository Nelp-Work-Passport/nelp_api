# Copy to .env. Never commit the real file.
ENVIRONMENT=development
DATABASE_URL=sqlite:///./nelp.db
# DATABASE_URL=postgresql://nelp:nelp@localhost:5432/nelp
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
PUBLIC_BASE_URL=http://localhost:3000
SEED_ON_STARTUP=true

# Production needs PostgreSQL: the filesystem is wiped on every deploy.
# See DEPLOYMENT.md. Generate each with: openssl rand -hex 32
SECRET_KEY=
PAYMENT_WEBHOOK_SECRET=
SMS_DLR_SECRET=

# "demo" uses the labelled inbox. "thrivevas" needs app/adapters/sms.py completed first.
SMS_PROVIDER=demo
THRIVEVAS_API_KEY=
THRIVEVAS_SENDER_ID=

# S3 file storage (RumptyCloud). Uploads answer 503 until all of these are set.
S3_ENDPOINT_URL=https://s3.rumptycloud.com
S3_REGION=olas-closet
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Optional. Without a key the score explanation uses the fixed template.
ANTHROPIC_API_KEY=

# Seeded accounts
DEMO_PIN=1234
ADMIN_PHONE=+254711000000
ADMIN_PIN=
